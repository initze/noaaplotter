.idea
noaaplotter/__pycache__
**/__pycache__/
Session.log
.env
*.egg-info/
.venv/

# plotly renders (regenerable via examples)
figures/*.html

# docs build output (built by CI, never committed)
site/

# generated data & plot artifacts (regenerable via download_data / plot_daily)
data/*.parquet
data/*.csv
examples/out/
*.html
*.png

# keep the committed example figures (overrides *.png above)
!figures/
!figures/*.png

# ── docs ────────────────────────────────────────────────────────────────────────
# keep docs example figure (overrides *.png above)
!docs/figures/
!docs/figures/*.png

# live interactive examples embedded in the docs Examples page (overrides *.html above)
!docs/interactive/
!docs/interactive/*.html

# scratch / diagnostics
scratch_*.py
.hermes/
