# Copy this file to .env and fill in your real keys. .env is git-ignored.

# NOAA CDO web API token (required for NOAA station data)
# Get one at: https://www.ncdc.noaa.gov/cdo-web/token
NOAA_API_TOKEN=

# Copernicus CDS API credentials (required for ERA5 reanalysis data)
# Get them at: https://cds.climate.copernicus.eu (account -> API)
CDS_API_TOKEN=
CDS_API_URL=https://cds.climate.copernicus.eu/api
