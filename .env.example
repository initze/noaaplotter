# Copy this file to .env and fill in your real keys. .env is git-ignored.

# NOAA station data: NO token required. The NOAA source uses NOAA's public
# NCEI Access Data Service (https://www.ncei.noaa.gov/access/services/data/v1).
# A NOAA_API_TOKEN, if present, is accepted for backward compatibility but is
# ignored (it belonged to the older token-based CDO Web Services API), and a
# DeprecationWarning is raised when one is supplied.
# NOAA_API_TOKEN=

# Copernicus CDS API credentials (required ONLY for the `cds` ERA5 source;
# the `open_meteo` ERA5 source needs no key). Get them at
# https://cds.climate.copernicus.eu (login -> My Data -> API)
CDS_API_TOKEN=           # Copernicus CDS API token (cds source)
CDS_API_URL=https://cds.climate.copernicus.eu/api
